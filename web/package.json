{
  "name": "@payoff/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src test e2e *.ts *.json README.md",
    "format:check": "prettier --check src test e2e *.ts *.json README.md"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
